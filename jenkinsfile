pipeline {
    agent any

    stages {
        stage('Build Docker Image') {
            steps {
                script {
                    sh 'docker build -t ahmedgamil/docker-react -f Dockerfile.dev .'
                }
            }
        }

        stage('Run Tests') {
            steps {
                script {
                    sh 'docker run -e CI=true ahmedgamil/docker-react npm run test'
                }
            }
        }
    }
}
